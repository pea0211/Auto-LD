   --------------------------------------------------------------------------
   --- Construct ORT of a seed equation and list feasible branches
   --------------------------------------------------------------------------
   rl [ortofseed-no-data] :
      < cafeInMaude : CIM | state: executeComm,
         input: 'ORT`of_.['neTokenList[T]],
         ipsgLast: < null ; null ; null >, AtS >
