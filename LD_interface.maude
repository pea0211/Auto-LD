load IPSG/ipsg_interface.maude
load ld_grammar.maude
load ld_lemma_discovery.maude

mod LD is
  pr MTP .
  pr LD-GRAMMAR .
  pr LEMMA-DISCOVERY .

   vars Text : String .
   vars TL IN : TermList .
   vars T T2 : Term .
   vars N : Nat .
   var  Ty : Type .
   var  AtS : AttributeSet .
   vars INSP1 : IPSGInputSpec .
   vars MS1 : IPSGModuleSpec .
   vars PRSCS1 : IPSGProofScores .

   ***                           ***
   ***       User command        ***
   ***                           ***
   crl [LDparseComm] : gotLine(cafeInMaude, stdin, Text)
   < cafeInMaude : CIM | state: idle, input: IN, AtS >
   => < cafeInMaude : CIM | state: executeComm, input: TL, AtS >
   if {T, Ty} := metaParse(LDGRAMMAR, tokenize(Text), '@Input@)
   /\ TL := extractTerms(T) .

   ***                        ***
   ***          ERROR         ***
   ***                        ***
   crl [LDparseCommError] : gotLine(cafeInMaude, stdin, Text)
   < cafeInMaude : CIM | state: idle, AtS >
   => < cafeInMaude : CIM | state: print&idle, AtS >
   write(stdout, cafeInMaude, "The introduced command does not exit.\n")
   if noParse(N) := metaParse(LDGRAMMAR, tokenize(Text), '@Input@) .

***********************
***********************
*** Lemma_Discovery ***
***********************
***********************

   --------------------------------------------------------------------------
   --- Show proof score by id
   --------------------------------------------------------------------------
   rl [showprsc-no-data] :
      < cafeInMaude : CIM | state: executeComm,
         input: 'show`prsc`by_.['neTokenList[T]],
         ipsgLast: < null ; null ; null >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: empty,
            ipsgLast: < null ; null ; null >, AtS >
         write(stdout, cafeInMaude, "No stored proof scores. Run IPSG on a protocol first.\n") .

   crl [showprsc] :
      < cafeInMaude : CIM | state: executeComm,
         input: 'show`prsc`by_.['neTokenList[T]],
         ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: empty,
            ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
         write(stdout, cafeInMaude,
            showPrscLastStr(INSP1, MS1, PRSCS1, psIdInputStr(T)) + "\n")
      if INSP1 =/= null /\ MS1 =/= null /\ PRSCS1 =/= null .

   rl [showprsc-no-data-queued] :
      < cafeInMaude : CIM | state: executeComm,
         input: ('show`prsc`by_.['neTokenList[T]], TL),
         ipsgLast: < null ; null ; null >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: TL,
            ipsgLast: < null ; null ; null >, AtS >
         write(stdout, cafeInMaude, "No stored proof scores. Run IPSG on a protocol first.\n") .

   crl [showprsc-queued] :
      < cafeInMaude : CIM | state: executeComm,
         input: ('show`prsc`by_.['neTokenList[T]], TL),
         ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: TL,
            ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
         write(stdout, cafeInMaude,
            showPrscLastStr(INSP1, MS1, PRSCS1, psIdInputStr(T)) + "\n")
      if INSP1 =/= null /\ MS1 =/= null /\ PRSCS1 =/= null .

   --------------------------------------------------------------------------
