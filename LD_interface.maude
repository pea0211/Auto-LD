         input: 'ORT`of_.['neTokenList[T]],
         ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: empty,
            ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
         write(stdout, cafeInMaude,
            ortOfSeedInputLastStrLD(INSP1, MS1, seedEqInputStr(T)))
      if INSP1 =/= null /\ MS1 =/= null .

