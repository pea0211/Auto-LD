   crl [listfalsecases] :
      < cafeInMaude : CIM | state: executeComm,
         input: 'list`false`cases`.,
         ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
      => < cafeInMaude : CIM | state: print&idle,
            input: empty,
            ipsgLast: < INSP1 ; MS1 ; PRSCS1 >, AtS >
         write(stdout, cafeInMaude,
            falseCaseReportLastStr(INSP1, PRSCS1) + "\n")
      if INSP1 =/= null /\ PRSCS1 =/= null .

   rl [listfalsecases-no-data-ann] :
      < cafeInMaude : CIM | state: executeComm,
         input: 'list`false`cases`..@Input@,
